# SQL Server database for FDSC (run db/schema.sql on it once).
DB_SERVER=localhost
DB_DATABASE=FDSC
DB_USER=
DB_PASSWORD=
DB_PORT=1433
# true for Azure SQL, false for a local SQL Server
DB_ENCRYPT=false

# Admin sessions: a long random secret (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FDSC_ADMIN_AUTH_SECRET=
FDSC_ADMIN_TOKEN_TTL_SECONDS=28800

# Web addresses allowed to call this API (comma separated). Empty = any origin (local development).
CORS_ORIGINS=http://localhost:5190
PORT=5011

# Forgot-password OTP by SMS. Leave SMS_PROVIDER empty in development: the OTP is printed
# in this API's console. Production (India): a DLT-registered sender ID and OTP template.
# SMS_PROVIDER=fast2sms is supported out of the box.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
